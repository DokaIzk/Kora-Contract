{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyThisServiceEnvironmentSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:/kora/ENVIRONMENT/SERVICE-??????"
    }
  ]
}